# Telegram Bot
TELEGRAM_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-numeric-chat-id

# Ollama (local LLM fallback - OPTIONAL, the cloud cascade works without it)
#   macOS / Linux : Ollama runs on this machine; leave blank for localhost:11434
#   WSL2          : leave blank and the Windows host IP is auto-detected
OLLAMA_URL=
DEFAULT_MODEL=qwen2.5:7b
CODE_MODEL=deepseek-coder:6.7b

# Cloud LLM cascade (Groq -> Gemini -> Local Ollama)
# Get free keys at: https://console.groq.com and https://aistudio.google.com/apikey
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# --- Voice notes (OPTIONAL) ---
# Speech-to-text for Telegram voice messages, via Sarvam (built for Indian
# languages and accents). Leave blank to disable: voice notes are then politely
# declined rather than ignored.
# Free credit on signup; STT is billed per hour of audio. https://sarvam.ai
SARVAM_API_KEY=
# Override only if Sarvam retires the default model.
# SARVAM_MODEL=saaras:v3
# SARVAM_LANGUAGE=unknown

# --- Auto-approve small orders (OPTIONAL, default OFF) ---
# Lets a user skip the tap-to-approve step for orders under a limit they set.
# This is the operator's master switch: while it is false, no chat can turn
# auto-approve on, whatever preference they saved earlier.
#
# NOTE: Swiggy's MCP exposes no wallet and no saved-card payment. The options
# are UPI (you approve in your UPI app), scan-QR, and cash on delivery. So this
# automates the APPROVAL, not the payment -- COD is the only fully hands-free
# combination, and a COD order still commits you to paying at the door.
COMMERCE_AUTOPAY_ENABLED=false
# Hard ceiling per order. A user may choose any limit up to this, not above it.
COMMERCE_AUTOPAY_MAX_RUPEES=500
# Rolling daily total across all auto-approved orders. Resets at local midnight.
COMMERCE_AUTOPAY_DAILY_RUPEES=1500

# Agent settings
#   macOS example : /Users/yourname/Projects/mimir-telegram-agent
#   WSL2 example  : /mnt/c/Users/yourname/ai-agent
# Leave unset to use the directory the project is checked out in.
WORKSPACE=
PERMISSION_TIMEOUT=300

# --- Agentic-commerce sidecar (shopping / transactions) ---
# The commerce BFF runs as a separate process with its own venv and its own
# pinned deps. Leave the URL as-is unless you moved it.
COMMERCE_BFF_URL=http://127.0.0.1:8011

# SECOND, INDEPENDENT SWITCH ON THE MONEY PATH.
# A real order requires BOTH the commerce service's own DRY_RUN=false AND this
# set to true. Leaving this alone means nothing can ever spend real money,
# whatever the other repo's .env says.
COMMERCE_ALLOW_LIVE=false

# Optional: comma-separated allowed paths for file operations.
# Defaults to the workspace + your home directory, plus mounted volumes
# (/Volumes/* on macOS, /mnt/<drive> on WSL).
#   macOS example : /Users/yourname,/Volumes/External
#   WSL2 example  : /mnt/c/Users/yourname,/mnt/d
# ALLOWED_PATHS=
