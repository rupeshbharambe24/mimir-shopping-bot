# Copy to `.env` and fill in. `.env` is gitignored.

# --- Gemini (agent loop) ---
# Free-tier key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Swiggy provider ---
# Path to the cached Swiggy OAuth token + client files produced by the login
# flow (backend/providers/swiggy/auth.py). If these don't exist, the first live
# connection triggers the browser OAuth flow and writes them here.
SWIGGY_TOKENS_PATH=./.swiggy_tokens.json
SWIGGY_CLIENT_PATH=./.swiggy_client.json

# --- Safety ---
# When true, checkout/poll_payment are intercepted and faked: NO real order is
# placed and NO money moves. Keep true until you deliberately go live.
DRY_RUN=true
