# Copy to `.env` and fill in. `.env` is gitignored.

# --- Gemini (agent loop) ---
# Free-tier key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Swiggy provider ---
# Path to the cached Swiggy OAuth token + client files produced by the login
# flow (backend/providers/swiggy/auth.py). If these don't exist, the first live
# connection triggers the browser OAuth flow and writes them here.
SWIGGY_TOKENS_PATH=./.swiggy_tokens.json
SWIGGY_CLIENT_PATH=./.swiggy_client.json

# --- Safety ---
# When true, checkout/poll_payment are intercepted and faked: NO real order is
# placed and NO money moves. Keep true until you deliberately go live.
DRY_RUN=true

# --- Gemini quota resilience ---
# The free-tier limit that actually bites is INPUT tokens per minute, and it is
# scoped PER MODEL (the 429 says: quotaId
# GenerateContentInputTokensPerModelPerMinute-FreeTier, quotaDimensions.model).
# So a second model is a real fallback with its own 250,000/min bucket, not a
# retry against the same wall. Tried in order when the primary is rate-limited.
#
# NOTE: GROQ_API_KEY does NOT apply here. The Groq/Gemini/Ollama cascade lives
# in the bot's SmartLLM; this commerce agent speaks Gemini's function-calling
# dialect only.
GEMINI_MODEL_FALLBACKS=gemini-flash-latest,gemini-2.5-flash

# How many complete user turns of context the agent carries. History used to be
# untrimmed, so every turn re-uploaded every earlier product-search payload --
# which is what exhausted the input-token quota, rather than any real volume of
# use. Lower this if you still hit limits; raise it if the agent forgets.
AGENT_MAX_USER_TURNS=6
