<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  MIMIR as a macOS LaunchAgent. Generated by setup.sh; do not edit the copy in
  ~/Library/LaunchAgents by hand, it is overwritten on the next setup run.

  Deliberately a LaunchAgent (~/Library/LaunchAgents), NOT a LaunchDaemon:
  a Daemon starts at boot but runs outside any login session, with no access to
  the window server. MIMIR would start fine and then fail every /screenshot and
  every /open, because those need a GUI session. An Agent starts at login and
  has one.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mimir.agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>__VENV_DIR__/bin/python3</string>
        <string>__PROJECT_DIR__/main.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <!-- launchd hands a job a bare PATH (/usr/bin:/bin:/usr/sbin:/sbin), so
         Homebrew, node, npm and ollama are all invisible to shell_command
         unless PATH is set here. This is the single most common reason a job
         that works in Terminal fails under launchd. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__BREW_PREFIX__/bin:__BREW_PREFIX__/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- Mirrors systemd's Restart=on-failure: a clean exit (the /stop command)
         stays stopped; a crash comes back. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/launchd.err.log</string>
</dict>
</plist>
